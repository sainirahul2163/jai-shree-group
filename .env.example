# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel access (comma-separated emails, server-only)
ADMIN_EMAILS=

# Resend (email notifications)
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=
CONTACT_EMAIL=

# Multi-site (Phase 0): send every lead email here in dev and preview
LEAD_EMAIL_OVERRIDE=

# Site
# Overrides the group site's origin only; unit sites take their origin from src/sites/<key>.ts
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional — search console verification (group site; unit domains verify by DNS)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
